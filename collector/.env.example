# Copy to .env and adjust. All optional — sane defaults are baked in.
PORT=8787
CORS_ORIGIN=*
DB_DRIVER=sqlite
SQLITE_PATH=./data/liquidations.db
# Phase: when you move to Postgres, set DB_DRIVER=postgres and DATABASE_URL=...
# DATABASE_URL=postgres://user:pass@localhost:5432/marginpad

# Binance fstream is geo-blocked in some regions (socket opens but delivers 0 data; our VPS + residential
# are both blocked). Point this at an HTTP(S) CONNECT proxy in an ALLOWED region to route ONLY the Binance
# collector through it (Bybit/OKX/BitMEX/Deribit stay direct). Supports embedded credentials. NOT SOCKS.
# Leave unset to skip Binance. Requires `npm install` (adds the `undici` dependency).
# BINANCE_PROXY=http://user:pass@proxy-host.example:8080
