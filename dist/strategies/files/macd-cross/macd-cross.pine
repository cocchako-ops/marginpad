//@version=6
// MACD Cross - Long from the MACD crossing its signal line until it crosses back.
// From the MarginPad strategy library: https://marginpad.io/strategies/macd-cross/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("MACD Cross [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

[macdLine, macdSignal, _h] = ta.macd(close, 12, 26, 9)

longIn = ta.crossover(macdLine, macdSignal)
longOut = ta.crossunder(macdLine, macdSignal)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
