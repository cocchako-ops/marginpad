//@version=6
// OBV Trend - Long while On-Balance Volume is above its own average.
// From the MarginPad strategy library: https://marginpad.io/strategies/obv-trend/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("OBV Trend [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.obv, ta.ema(ta.obv, 20))
longOut = ta.crossunder(ta.obv, ta.ema(ta.obv, 20))

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
