//@version=6
// Supertrend 20/5 - A wide Supertrend that aims to hold the big moves.
// From the MarginPad strategy library: https://marginpad.io/strategies/supertrend-slow/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Supertrend 20/5 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

stDir(int p, float m) =>
    [_v, d] = ta.supertrend(m, p)
    -d

longIn = stDir(20, 5) > 0
longOut = stDir(20, 5) < 0

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
