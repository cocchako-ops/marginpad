//@version=6
// Time Exit Momentum - Buy a 20-bar high and simply leave after ten bars.
// From the MarginPad strategy library: https://marginpad.io/strategies/time-exit-momentum/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Time Exit Momentum [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = close > ta.highest(high, 20)[1]

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) + 1 >= 10
    strategy.close_all()
