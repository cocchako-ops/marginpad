//@version=6
// Trailing Stop Trend - A 20/50 trend entry; a 3 ATR trail decides the exit.
// From the MarginPad strategy library: https://marginpad.io/strategies/trailing-stop-trend/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Trailing Stop Trend [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

atr14 = ta.atr(14)

longIn = ta.crossover(ta.ema(close, 20), ta.ema(close, 50))

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size > 0
    entry = strategy.opentrades.entry_price(0)
    var float risk = na
    if strategy.opentrades.entry_bar_index(0) == bar_index or na(risk)
        risk := 3 * atr14[1]
    stopPx = entry - risk
    trailPx = close - 3 * atr14
    var float best = na
    best := na(best) or strategy.opentrades.entry_bar_index(0) == bar_index ? trailPx : math.max(best, trailPx)
    stopPx := math.max(stopPx, best)
    strategy.exit("Long exit", "Long", stop=stopPx)
