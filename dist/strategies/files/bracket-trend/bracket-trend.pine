//@version=6
// Bracket Trend - A trend entry with a fixed +6% target and -3% stop.
// From the MarginPad strategy library: https://marginpad.io/strategies/bracket-trend/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Bracket Trend [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

atr14 = ta.atr(14)

longIn = ta.ema(close, 20) > ta.ema(close, 50)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size > 0
    entry = strategy.opentrades.entry_price(0)
    var float risk = na
    if strategy.opentrades.entry_bar_index(0) == bar_index or na(risk)
        risk := entry * 0.03
    stopPx = entry - risk
    tpPx = entry + entry * 0.06
    strategy.exit("Long exit", "Long", stop=stopPx, limit=tpPx)
