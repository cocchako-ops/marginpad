//@version=6
// RSI-2 With Trend Filter - The same dip, bought only above the 200 SMA.
// From the MarginPad strategy library: https://marginpad.io/strategies/rsi-2-trend-filter/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("RSI-2 With Trend Filter [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


c1 = ta.rsi(close, 2) < 10
c2 = close > ta.sma(close, 200)
longIn = (c1 and c2)
longOut = ta.rsi(close, 2) > 60

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
