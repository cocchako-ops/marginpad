//@version=6
// Close Near The Low - Buy a close in the bottom fifth of the bar, in an uptrend.
// From the MarginPad strategy library: https://marginpad.io/strategies/ibs-reversion/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Close Near The Low [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


c1 = ((close - low) / (high - low)) < 0.2
c2 = close > ta.sma(close, 200)
longIn = (c1 and c2)
longOut = ((close - low) / (high - low)) > 0.8

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
