//@version=6
// DI Cross - Long while +DI leads -DI.
// From the MarginPad strategy library: https://marginpad.io/strategies/di-cross/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("DI Cross [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

dmiPlus(int p) =>
    [a, b, c] = ta.dmi(p, p)
    a
dmiMinus(int p) =>
    [a, b, c] = ta.dmi(p, p)
    b
dmiAdx(int p) =>
    [a, b, c] = ta.dmi(p, p)
    c

longIn = ta.crossover(dmiPlus(14), dmiMinus(14))
longOut = ta.crossunder(dmiPlus(14), dmiMinus(14))

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
