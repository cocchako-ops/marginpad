//@version=6
// EMA 20/50 Cross - A slower cross that sits out more of the chop.
// From the MarginPad strategy library: https://marginpad.io/strategies/ema-20-50-cross/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("EMA 20/50 Cross [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.ema(close, 20), ta.ema(close, 50))
longOut = ta.crossunder(ta.ema(close, 20), ta.ema(close, 50))

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
