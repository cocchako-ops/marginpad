//@version=6
// EMA 21 Pullback - In an uptrend, buy the dip to the 21 EMA: 1.5 ATR stop, 3R target.
// From the MarginPad strategy library: https://marginpad.io/strategies/pullback-ema-21/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("EMA 21 Pullback [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

atr14 = ta.atr(14)

c1 = ta.ema(close, 21) > ta.ema(close, 50)
c2 = low < ta.ema(close, 21)
c3 = close > ta.ema(close, 21)
longIn = (c1 and c2 and c3)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) + 1 >= 48
    strategy.close_all()
if strategy.position_size > 0
    entry = strategy.opentrades.entry_price(0)
    var float risk = na
    if strategy.opentrades.entry_bar_index(0) == bar_index or na(risk)
        risk := 1.5 * atr14[1]
    stopPx = entry - risk
    tpPx = entry + risk * 3
    strategy.exit("Long exit", "Long", stop=stopPx, limit=tpPx)
