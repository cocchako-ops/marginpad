//@version=6
// Stretch Below SMA 20 - Buy 2% below the 20 SMA, sell back at it.
// From the MarginPad strategy library: https://marginpad.io/strategies/stretch-below-sma/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Stretch Below SMA 20 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = close < (ta.sma(close, 20) * 0.98)
longOut = close > ta.sma(close, 20)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
