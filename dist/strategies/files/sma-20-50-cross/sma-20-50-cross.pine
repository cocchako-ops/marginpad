//@version=6
// SMA 20/50 Cross - The classic moving-average cross on simple averages.
// From the MarginPad strategy library: https://marginpad.io/strategies/sma-20-50-cross/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("SMA 20/50 Cross [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.sma(close, 20), ta.sma(close, 50))
longOut = ta.crossunder(ta.sma(close, 20), ta.sma(close, 50))

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
