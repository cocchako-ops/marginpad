//@version=6
// Trend + MACD - MACD entries, allowed only above the 200 SMA.
// From the MarginPad strategy library: https://marginpad.io/strategies/trend-and-macd/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Trend + MACD [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

[macdLine, macdSignal, _h] = ta.macd(close, 12, 26, 9)

c1 = ta.crossover(macdLine, macdSignal)
c2 = close > ta.sma(close, 200)
longIn = (c1 and c2)
c3 = ta.crossunder(macdLine, macdSignal)
c4 = close < ta.sma(close, 200)
longOut = (c3 or c4)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
