//@version=6
// Sunday Close To Monday - Hold one day from the Sunday close. A test of a well-known crypto folk rule.
// From the MarginPad strategy library: https://marginpad.io/strategies/monday-effect/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Sunday Close To Monday [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

dow = dayofweek(time, "UTC") - 1

c1 = dow > -1
c2 = dow < 1
longIn = (c1 and c2)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) + 1 >= 1
    strategy.close_all()
