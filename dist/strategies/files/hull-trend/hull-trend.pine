//@version=6
// Hull Trend - Long while the Hull moving average is rising.
// From the MarginPad strategy library: https://marginpad.io/strategies/hull-trend/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Hull Trend [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.hma(close, 21), (ta.hma(close, 21))[1])
longOut = ta.crossunder(ta.hma(close, 21), (ta.hma(close, 21))[1])

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
