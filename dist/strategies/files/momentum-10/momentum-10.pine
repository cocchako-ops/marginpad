//@version=6
// Momentum 10 - Long while price is above where it was ten bars ago.
// From the MarginPad strategy library: https://marginpad.io/strategies/momentum-10/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Momentum 10 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.roc(close, 10), 0)
longOut = ta.crossunder(ta.roc(close, 10), 0)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
