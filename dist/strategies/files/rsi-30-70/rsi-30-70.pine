//@version=6
// RSI Reversion 30/70 - Buy RSI under 30, sell over 70.
// From the MarginPad strategy library: https://marginpad.io/strategies/rsi-30-70/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("RSI Reversion 30/70 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.rsi(close, 14) < 30
longOut = ta.rsi(close, 14) > 70

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
