//@version=6
// Trend Pullback 1% - In an uptrend, buy a 1% dip under the 20 EMA.
// From the MarginPad strategy library: https://marginpad.io/strategies/pullback-1-percent/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Trend Pullback 1% [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

atr14 = ta.atr(14)

c1 = ta.ema(close, 20) > ta.ema(close, 50)
c2 = close < (ta.ema(close, 20) * 0.99)
longIn = (c1 and c2)
longOut = ta.ema(close, 20) < ta.ema(close, 50)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
if strategy.position_size > 0
    entry = strategy.opentrades.entry_price(0)
    var float risk = na
    if strategy.opentrades.entry_bar_index(0) == bar_index or na(risk)
        risk := 3 * atr14[1]
    stopPx = entry - risk
    strategy.exit("Long exit", "Long", stop=stopPx)
