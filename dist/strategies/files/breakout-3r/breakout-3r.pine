//@version=6
// Breakout With 3R Target - A 20-bar high with a 2 ATR stop and a target three times the risk.
// From the MarginPad strategy library: https://marginpad.io/strategies/breakout-3r/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Breakout With 3R Target [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

atr14 = ta.atr(14)

longIn = close > ta.highest(high, 20)[1]

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size > 0
    entry = strategy.opentrades.entry_price(0)
    var float risk = na
    if strategy.opentrades.entry_bar_index(0) == bar_index or na(risk)
        risk := 2 * atr14[1]
    stopPx = entry - risk
    tpPx = entry + risk * 3
    strategy.exit("Long exit", "Long", stop=stopPx, limit=tpPx)
