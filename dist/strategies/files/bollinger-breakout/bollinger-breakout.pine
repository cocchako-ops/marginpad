//@version=6
// Bollinger Breakout - Buy a close above the upper band, exit at the mid-line.
// From the MarginPad strategy library: https://marginpad.io/strategies/bollinger-breakout/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Bollinger Breakout [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = close > (ta.sma(close, 20) + (ta.stdev(close, 20) * 2))
longOut = close < ta.sma(close, 20)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
