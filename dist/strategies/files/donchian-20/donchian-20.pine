//@version=6
// Donchian Breakout 20 - Buy a new 20-bar high, sell a new 10-bar low.
// From the MarginPad strategy library: https://marginpad.io/strategies/donchian-20/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Donchian Breakout 20 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = close > ta.highest(high, 20)[1]
longOut = close < ta.lowest(low, 10)[1]

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
