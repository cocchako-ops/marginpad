//@version=6
// ADX Trend Filter - An EMA trend, taken only when ADX says a trend exists.
// From the MarginPad strategy library: https://marginpad.io/strategies/adx-trend/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("ADX Trend Filter [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

dmiPlus(int p) =>
    [a, b, c] = ta.dmi(p, p)
    a
dmiMinus(int p) =>
    [a, b, c] = ta.dmi(p, p)
    b
dmiAdx(int p) =>
    [a, b, c] = ta.dmi(p, p)
    c

c1 = ta.ema(close, 20) > ta.ema(close, 50)
c2 = dmiAdx(14) > 25
longIn = (c1 and c2)
longOut = ta.ema(close, 20) < ta.ema(close, 50)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
