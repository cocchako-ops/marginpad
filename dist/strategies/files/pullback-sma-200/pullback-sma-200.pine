//@version=6
// Dip Above SMA 200 - A five-period RSI under 30, above the 200 SMA.
// From the MarginPad strategy library: https://marginpad.io/strategies/pullback-sma-200/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Dip Above SMA 200 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


c1 = close > ta.sma(close, 200)
c2 = ta.rsi(close, 5) < 30
longIn = (c1 and c2)
longOut = close > ta.sma(close, 5)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
