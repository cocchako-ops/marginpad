//@version=6
// Dip or Breakout - Takes whichever comes first: an RSI dip or a 20-day high.
// From the MarginPad strategy library: https://marginpad.io/strategies/oco-dip-or-breakout/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Dip or Breakout [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)

atr14 = ta.atr(14)

c1 = ta.crossunder(ta.rsi(close, 14), 35)
c2 = close > ta.highest(high, 20)[1]
longIn = (c1 or c2)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size > 0
    entry = strategy.opentrades.entry_price(0)
    var float risk = na
    if strategy.opentrades.entry_bar_index(0) == bar_index or na(risk)
        risk := entry * 0.08
    stopPx = entry - risk
    tpPx = entry + entry * 0.12
    strategy.exit("Long exit", "Long", stop=stopPx, limit=tpPx)
