//@version=6
// Volume Breakout - A 20-bar high on twice the normal volume.
// From the MarginPad strategy library: https://marginpad.io/strategies/volume-breakout/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Volume Breakout [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


c1 = close > ta.highest(high, 20)[1]
c2 = volume > (ta.sma(volume, 20) * 2)
longIn = (c1 and c2)
longOut = close < ta.ema(close, 20)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
