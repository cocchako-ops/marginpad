//@version=6
// CCI Reversion - Buy CCI crossing back above -100, sell over +100.
// From the MarginPad strategy library: https://marginpad.io/strategies/cci-reversion/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("CCI Reversion [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.cci(hlc3, 20), -100)
longOut = ta.cci(hlc3, 20) > 100

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
