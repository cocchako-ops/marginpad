//@version=6
// Squeeze Breakout - Bollinger bands inside Keltner, then the first close above the band.
// From the MarginPad strategy library: https://marginpad.io/strategies/squeeze-breakout/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Squeeze Breakout [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


c1 = close > (ta.sma(close, 20) + (ta.stdev(close, 20) * 2))
c2 = ((ta.sma(close, 20) + (ta.stdev(close, 20) * 2)))[1] < ((ta.ema(close, 20) + (ta.atr(20) * 1.5)))[1]
longIn = (c1 and c2)
longOut = close < ta.ema(close, 20)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
