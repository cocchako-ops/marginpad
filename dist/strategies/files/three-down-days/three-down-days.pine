//@version=6
// Three Down Closes - Buy after three lower closes in a row, hold five bars.
// From the MarginPad strategy library: https://marginpad.io/strategies/three-down-days/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Three Down Closes [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


c1 = close < (close)[1]
c2 = (close)[1] < (close)[2]
c3 = (close)[2] < (close)[3]
longIn = (c1 and c2 and c3)

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) + 1 >= 5
    strategy.close_all()
