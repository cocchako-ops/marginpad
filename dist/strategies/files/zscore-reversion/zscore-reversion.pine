//@version=6
// Z-Score Reversion 50 - Buy 2.5 deviations under the 50-day mean, sell once back within half a deviation, 20 bars at most.
// From the MarginPad strategy library: https://marginpad.io/strategies/zscore-reversion/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("Z-Score Reversion 50 [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ((close - ta.sma(close, 50)) / ta.stdev(close, 50)) < -2.5
longOut = ((close - ta.sma(close, 50)) / ta.stdev(close, 50)) > -0.5

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
if strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) + 1 >= 20
    strategy.close_all()
