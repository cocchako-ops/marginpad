//@version=6
// EMA 9/21 Cross - Long while the 9 EMA is above the 21 EMA.
// From the MarginPad strategy library: https://marginpad.io/strategies/ema-9-21-cross/
// Research, not advice. A backtest is evidence, never a promise. Licence: MIT.

strategy("EMA 9/21 Cross [MarginPad]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, pyramiding=0)


longIn = ta.crossover(ta.ema(close, 9), ta.ema(close, 21))
longOut = ta.crossunder(ta.ema(close, 9), ta.ema(close, 21))

if longIn and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longOut
    strategy.close("Long")
