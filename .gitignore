collector/data/
collector/backups/
collector/logs/

*.log
.env
.env.*
!.env.example

# cloudflare / wrangler
.wrangler/

# scratch screenshots used during development
_*.png

# os
Thumbs.db
.DS_Store

# build output — deployed via wrangler, not git (regenerate with: node build/build.js).
# dist/assets + hand-maintained pages (rekt, rewards, alerts, coins, news, sw.js, …) ARE tracked —
# they are sources, not build output (force-added; a NEW hand-made dist page needs `git add -f`).
dist/*
!dist/assets

